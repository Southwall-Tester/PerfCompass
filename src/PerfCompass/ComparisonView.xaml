<UserControl x:Class="PerfCompass.ComparisonView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PerfCompass">
 <UserControl.Resources>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E3EAEC"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E3EAEC"/><Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F4F7F8"/><Setter Property="AlternationCount" Value="2"/>
   <Setter Property="ColumnHeaderHeight" Value="42"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="CanUserSortColumns" Value="False"/>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EDF3F4"/><Setter Property="Foreground" Value="#192A36"/><Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#E3EAEC"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E5F3EE"/><Setter Property="Foreground" Value="#192A36"/></Trigger></Style.Triggers></Style>
  <Style x:Key="TableText" TargetType="TextBlock"><Setter Property="Margin" Value="8,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
 </UserControl.Resources>
 <StackPanel>
  <TextBlock Text="输入候选报价与配置，核对重要任务的最低要求。容量按配置表比较，性能按同一任务的实测结果比较。留空表示未知。" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
  <TextBlock x:Name="ContextStatus" Margin="0,0,0,14" Foreground="{StaticResource Accent}"/>
  <WrapPanel><Button x:Name="SaveDraftButton" Content="保存草稿" Click="SaveDraft_Click" Margin="0,0,10,8"/><Button x:Name="ExportDraftButton" Content="导出草稿" Click="ExportDraft_Click" Margin="0,0,10,8"/><Button x:Name="ImportDraftButton" Content="导入草稿" Click="ImportDraft_Click" Margin="0,0,0,8"/></WrapPanel>
  <TextBlock x:Name="DraftStatus" Text="编辑后自动保存草稿；保存草稿不会生成比较结论。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
  <Border x:Name="TriagePanel" Style="{StaticResource Card}" Margin="0,0,0,16"><Border.Resources><DataTemplate x:Key="TriageCaseTemplate"><StackPanel Margin="0,10,0,0">
    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Notice}" Foreground="#98631D" TextWrapping="Wrap"/>
    <Expander Header="需求与条件依据" FontSize="12" Margin="0,5,0,0"><TextBlock Text="{Binding Source}" TextWrapping="Wrap" Margin="0,7,0,0"/></Expander>
    <ItemsControl ItemsSource="{Binding Candidates}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E3EAEC" BorderThickness="0,0,0,1" Padding="0,10"><StackPanel>
     <DockPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding State}" Foreground="#007F73" HorizontalAlignment="Right" TextWrapping="Wrap" Margin="12,0,0,0"/></DockPanel>
     <TextBlock Text="{Binding Quote}" Foreground="#007F73" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding Specifications}" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="12"/>
     <TextBlock Text="{Binding ComparisonReason}" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="12"/>
     <TextBlock Text="{Binding IssueText}" Foreground="#98631D" TextWrapping="Wrap" Margin="0,5,0,0"/>
     <Expander Header="待核对项与资料来源" Margin="0,6,0,0"><StackPanel><TextBlock Text="{Binding ReasonText}" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,0"/><TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" Margin="0,7,0,0" FontSize="12"/><TextBlock Text="{Binding Sources}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,7,0,0" FontSize="12"/></StackPanel></Expander>
    </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></DataTemplate></Border.Resources><StackPanel>
   <DockPanel><TextBlock Text="候选自动初筛" FontSize="18" FontWeight="SemiBold"/><Button x:Name="ExportTriageButton" Content="导出初筛" Click="ExportTriage_Click" HorizontalAlignment="Right"/></DockPanel>
   <TextBlock x:Name="TriageStatus" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
   <Expander x:Name="TriageExpander" Header="查看具体机型与比较顺序" IsExpanded="True" Margin="0,10,0,0"><ItemsControl x:Name="TriageCases" ItemTemplate="{StaticResource TriageCaseTemplate}"/></Expander>
   <Expander x:Name="TriageConditionalExpander" Header="条件成立时的候选顺序" Visibility="Collapsed" Margin="0,10,0,0"><ItemsControl x:Name="TriageConditionalCases" ItemTemplate="{StaticResource TriageCaseTemplate}"/></Expander>
   <TextBlock x:Name="TriageNotice" Text="{x:Static local:CandidateTriage.Notice}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
   <DockPanel Margin="0,0,0,12"><TextBlock Text="候选电脑 · 最多三套" FontSize="18" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ImportProductPageButton" Content="从商品链接添加" Click="ImportProductPage_Click" Margin="8,0"/><Button x:Name="AddCandidateButton" Content="添加候选" Click="AddCandidate_Click" Margin="8,0"/><Button Content="删除选中候选" Click="RemoveCandidate_Click"/></StackPanel></DockPanel>
   <DataGrid x:Name="CandidatesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" Height="185" RowHeight="38" EnableRowVirtualization="False" FrozenColumnCount="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <DataGrid.Columns>
     <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="145"/>
     <DataGridTextColumn Header="报价 / 元" Binding="{Binding PriceCny}" Width="95"/>
     <DataGridTextColumn Header="内存 / GB" Binding="{Binding MemoryGb}" Width="95"/>
     <DataGridTextColumn Header="独立显存 / GB" Binding="{Binding VramGb}" Width="110"/>
     <DataGridTextColumn Header="存储 / GB" Binding="{Binding StorageGb}" Width="95"/>
     <DataGridTextColumn Header="CPU 型号" Binding="{Binding Cpu}" Width="170"/>
     <DataGridTextColumn Header="GPU 型号" Binding="{Binding Gpu}" Width="170"/>
     <DataGridTextColumn Header="报价 / 合并资料来源（含日期）" Binding="{Binding Source}" Width="300"/>
     <DataGridTextColumn Header="独立规格资料（可单独填写）" Binding="{Binding SpecificationSource}" Width="300"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="报价来源可填报价单、商品页与日期；独立规格资料只支持规格目标，不充当价格依据。型号名称不用于猜测性能，共享内存不能当作独立显存。1 TB = 1000 GB；GiB/TiB 请先换算。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
   <Expander Header="从规格摘录添加候选" Foreground="#007F73" Margin="0,12,0,0"><StackPanel Margin="0,12,0,0">
    <TextBlock Text="粘贴带字段名的规格文本，例如 Processor、Graphics、Memory、Storage 或处理器、显卡、内存、硬盘。预览后核对具体 SKU；此入口不联网取价。" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
    <TextBlock Text="资料来源（网址或文件说明）" Foreground="#192A36" Margin="0,12,0,5"/>
    <TextBox x:Name="SpecSourceBox" MaxLength="1000" Padding="8" TextChanged="SpecInputChanged" AutomationProperties.Name="规格资料来源"/>
    <TextBlock Text="规格摘录原文" Foreground="#192A36" Margin="0,12,0,5"/>
    <TextBox x:Name="SpecTextBox" MaxLength="8000" Height="140" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" TextChanged="SpecInputChanged" AutomationProperties.Name="规格摘录原文"/>
    <Button x:Name="SpecPreviewButton" Content="生成规格预览" Click="SpecPreview_Click" HorizontalAlignment="Left" Margin="0,12,0,8"/>
    <TextBlock x:Name="SpecImportStatus" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
    <StackPanel x:Name="SpecPreviewPanel" Visibility="Collapsed">
     <TextBlock Text="核对后的候选字段 · 容量单位为 GB，空白保留未知" Foreground="#192A36" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="名称 / 具体 SKU" Foreground="#192A36" Margin="0,10,0,4"/><TextBox x:Name="SpecNameBox" MaxLength="150" Padding="8" TextChanged="SpecFieldsChanged"/>
     <TextBlock Text="CPU" Foreground="#192A36" Margin="0,10,0,4"/><TextBox x:Name="SpecCpuBox" MaxLength="200" Padding="8" TextChanged="SpecFieldsChanged"/>
     <TextBlock Text="GPU" Foreground="#192A36" Margin="0,10,0,4"/><TextBox x:Name="SpecGpuBox" MaxLength="200" Padding="8" TextChanged="SpecFieldsChanged"/>
     <UniformGrid Columns="3" Margin="0,10,0,0">
      <StackPanel Margin="0,0,12,0"><TextBlock Text="内存 / GB" Foreground="#192A36" Margin="0,0,0,4"/><TextBox x:Name="SpecMemoryBox" MaxLength="100" Padding="8" TextChanged="SpecFieldsChanged"/></StackPanel>
      <StackPanel Margin="0,0,12,0"><TextBlock Text="独立显存 / GB" Foreground="#192A36" Margin="0,0,0,4"/><TextBox x:Name="SpecVramBox" MaxLength="100" Padding="8" TextChanged="SpecFieldsChanged"/></StackPanel>
      <StackPanel><TextBlock Text="存储 / GB" Foreground="#192A36" Margin="0,0,0,4"/><TextBox x:Name="SpecStorageBox" MaxLength="100" Padding="8" TextChanged="SpecFieldsChanged"/></StackPanel>
     </UniformGrid>
     <Button x:Name="SpecAddButton" Content="核对并添加候选" Click="SpecAdd_Click" HorizontalAlignment="Left" Margin="0,12,0,0" IsEnabled="False"/>
    </StackPanel>
   </StackPanel></Expander>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
   <TextBlock Text="购机条件与任务目标" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock Text="导入已确认需求、近期负载增加和未解决的体验问题。逐项检查比较类型、目标值和触发条件后勾选“已核对”。原文时间与购机用途分别核对；必须避免的内容按完整句子核对，用途待定的内容保留条件分支。" Foreground="{StaticResource Muted}" Margin="0,10,0,12"/>
   <WrapPanel Margin="0,0,0,12"><Button x:Name="ImportCriteriaButton" Content="导入当前需求与近期任务" Click="ImportCriteria_Click" Margin="0,0,8,8"/><Button x:Name="AddCriterionButton" Content="补充条件 / 实测目标" Click="AddCriterion_Click" Margin="0,0,8,8"/><Button x:Name="RemoveCriterionButton" Content="删除选中条件" Click="RemoveCriterion_Click" Margin="0,0,8,8"/><Button x:Name="DetachCriterionButton" Content="保留所选为独立目标" Click="DetachCriterion_Click" Margin="0,0,0,8"/></WrapPanel>
   <TextBlock x:Name="SemanticSourceNotice" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#98631D" Margin="0,0,0,12"/>
   <DataGrid x:Name="CriteriaGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Height="240" RowHeight="40" EnableRowVirtualization="False" FrozenColumnCount="2" SelectionMode="Single">
    <DataGrid.Columns>
     <DataGridCheckBoxColumn Header="已核对" Binding="{Binding Reviewed}" Width="65"/>
     <DataGridTextColumn Header="条件或任务" Binding="{Binding Name}" Width="255"/>
     <DataGridComboBoxColumn Header="比较类型" ItemsSource="{x:Static local:CandidateComparison.Metrics}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValueBinding="{Binding Metric}" Width="155"/>
     <DataGridComboBoxColumn Header="目标" ItemsSource="{x:Static local:CandidateComparison.Directions}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValueBinding="{Binding Direction}" Width="105"/>
     <DataGridTextColumn Header="目标值" Binding="{Binding Target}" Width="85"/>
     <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="70"/>
     <DataGridTextColumn Header="触发条件（无条件则留空）" Binding="{Binding Condition}" Width="230"/>
     <DataGridTextColumn Header="需求依据 / 原文" Binding="{Binding Evidence}" Width="280"/>
     <DataGridTextColumn Header="统一测试步骤与环境" Binding="{Binding Procedure}" Width="300"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="“逐项核对”用于软件兼容性、排除项或尚未量化的目标；“实际任务测量”可填耗时、帧率、噪声等，需统一单位、软件版本、任务数据及设置。规格字段使用表头固定单位。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
   <TextBlock Text="任务测试与逐项核对结果" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <WrapPanel Margin="0,0,0,12"><Button x:Name="PrepareMeasurementsButton" Content="生成 / 更新结果行" Click="PrepareMeasurements_Click" Margin="0,0,8,8"/><Button x:Name="OpenTaskMeasurementButton" Content="运行任务测量" Click="OpenTaskMeasurement_Click" Margin="0,0,8,8"/><Button x:Name="ImportTaskMeasurementButton" Content="导入所选行的测量" Click="ImportTaskMeasurement_Click" Margin="0,0,0,8"/></WrapPanel>
   <DataGrid x:Name="ObservationsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Height="240" RowHeight="40" EnableRowVirtualization="False" FrozenColumnCount="2">
    <DataGrid.Columns>
     <DataGridTextColumn Header="候选" Binding="{Binding CandidateName}" IsReadOnly="True" Width="130"/>
     <DataGridTextColumn Header="条件或任务" Binding="{Binding CriterionName}" IsReadOnly="True" Width="220"/>
     <DataGridTextColumn Header="实测数值" Binding="{Binding Value}" Width="100"/>
     <DataGridComboBoxColumn Header="逐项核对" ItemsSource="{x:Static local:CandidateComparison.Verdicts}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValueBinding="{Binding Verdict}" Width="100"/>
     <DataGridCheckBoxColumn Header="机器与测试已核对" Binding="{Binding Comparable}" Width="135"/>
     <DataGridTextColumn Header="测量记录或核对依据" Binding="{Binding Evidence}" Width="350"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="仅生成需要实测或人工核对的项目。填写依据并勾选后才使用；实测值与目标使用同一单位。步骤、软件或输入改变时，应重新测量。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
  </StackPanel></Border>
  <CheckBox x:Name="CoverageConfirm" Content="已核对条件覆盖重要任务、新需求、近期体验问题和需要保留的偶发任务" Margin="0,4,0,16"/>
  <WrapPanel><Button x:Name="CompareButton" Content="保存并比较" Click="Compare_Click" Background="#007F73" Foreground="White" Margin="0,0,10,10"/><Button x:Name="ExportComparisonButton" Content="导出比较报告" Click="ExportComparison_Click" IsEnabled="False" Margin="0,0,0,10"/></WrapPanel>
  <TextBlock x:Name="ComparisonStatus" Margin="0,4,0,16" Foreground="{StaticResource Muted}"/>
  <StackPanel x:Name="ComparisonOutcomePanel">
  <TextBlock x:Name="ComparisonSummary" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
  <Expander x:Name="ShortlistExpander" Header="购机建议与加价取舍" Visibility="Collapsed" Margin="0,0,0,16" Foreground="#007F73">
   <ItemsControl x:Name="ComparisonShortlists" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
    <TextBlock Text="{Binding Scope}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Summary}" Foreground="#192A36" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,12" TextWrapping="Wrap"/>
    <ItemsControl ItemsSource="{Binding Options}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12">
     <TextBlock Text="{Binding Name}" Foreground="#192A36" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Label}" Foreground="#007F73" Margin="0,5,0,4" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding Detail}" Foreground="#45606C" TextWrapping="Wrap" LineHeight="22"/>
    </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="{Binding Notice}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21"/>
   </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </Expander>
  <ItemsControl x:Name="ComparisonConflicts" Margin="0,0,0,12"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" BorderBrush="#B56A30" BorderThickness="1" Margin="0,0,0,12"><StackPanel><TextBlock Text="条件数值冲突" FontWeight="SemiBold" Foreground="#98551D" Margin="0,0,0,8"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <ItemsControl x:Name="ComparisonScenarios" Margin="0,0,0,12"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,12"><TextBlock Text="{Binding}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <ItemsControl x:Name="ComparisonTradeoffs" Margin="0,0,0,16"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,0,0,12"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <ItemsControl x:Name="ComparisonResults"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
   <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" Margin="0,8,0,12"/>
   <Expander Tag="candidate-specification" Header="查看独立规格资料与摘录原文" Margin="0,0,0,12"><Expander.Style><Style TargetType="Expander"><Style.Triggers><DataTrigger Binding="{Binding SpecificationSource}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Expander.Style>
    <TextBlock Text="{Binding SpecificationSource}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="21" Margin="0,10,0,0"/>
   </Expander>
   <ItemsControl ItemsSource="{Binding Checks}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,14"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Reading}"/><TextBlock Text="{Binding ConditionLabel}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Evidence}" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
 </StackPanel>
</UserControl>
