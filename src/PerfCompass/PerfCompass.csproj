<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <Version>0.8.0</Version>
    <AssemblyName>PerfCompass</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\tests\nlp-cases.json" LogicalName="PerfCompass.NlpCases.json" />
    <EmbeddedResource Include="..\..\tests\quantity-cases.json" LogicalName="PerfCompass.QuantityCases.json" />
    <EmbeddedResource Include="..\..\tests\nlp-output.schema.json" LogicalName="PerfCompass.SemanticSchema.json" />
    <EmbeddedResource Include="..\..\tests\nlp-extraction-prompt.txt" LogicalName="PerfCompass.SemanticPrompt.txt" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <Resource Include="Assets\App.ico"/>
  </ItemGroup>
</Project>
