<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <Version>0.8.34</Version>
    <AssemblyName>PerfCompass</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\tests\fixtures\product-page-dell.html" LogicalName="PerfCompass.ProductPageDell.html" />
    <EmbeddedResource Include="..\..\tests\fixtures\comparison-1.2-uncertainty.json" LogicalName="PerfCompass.LegacyUncertainty.json" />
    <EmbeddedResource Include="..\..\tests\fixtures\task-measurement-1.0-input-restore.json" LogicalName="PerfCompass.LegacyInputMeasurement.json" />
    <EmbeddedResource Include="..\..\tests\fixtures\task-plan-1.0-input-restore.json" LogicalName="PerfCompass.LegacyInputPlan.json" />
    <EmbeddedResource Include="..\..\tests\nlp-cases.json" LogicalName="PerfCompass.NlpCases.json" />
    <EmbeddedResource Include="..\..\tests\quantity-cases.json" LogicalName="PerfCompass.QuantityCases.json" />
    <EmbeddedResource Include="..\..\tests\semantic-results\qwen3-4b-production\case-12.json" LogicalName="PerfCompass.ProviderCase12.json" />
    <EmbeddedResource Include="..\..\tests\semantic-results\qwen3-4b-production\case-14.json" LogicalName="PerfCompass.ProviderCase14.json" />
    <EmbeddedResource Include="..\..\tests\nlp-output.schema.json" LogicalName="PerfCompass.SemanticSchema.json" />
    <EmbeddedResource Include="..\..\tests\nlp-extraction-prompt.txt" LogicalName="PerfCompass.SemanticPrompt.txt" />
    <ProjectReference Include="..\..\vendor\LibreHardwareMonitor\LibreHardwareMonitorLib\LibreHardwareMonitorLib.csproj" />
    <Resource Include="Assets\App.ico"/>
  </ItemGroup>
</Project>
