<Window x:Class="PerfCompass.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PerfCompass"
 Title="PerfCompass · 配置指南" Icon="Assets/App.ico" Width="1240" Height="820" MinWidth="960" MinHeight="640" Background="#F4F7F8" Foreground="{StaticResource Ink}" FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen">
 <Grid Background="#F4F7F8">
  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#132D38" Padding="20,30">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="◈" Foreground="#55D5BC" FontSize="38" Margin="8,0,0,8"/>
     <TextBlock Text="PerfCompass" Foreground="White" FontSize="21" FontWeight="SemiBold" Margin="6,0,0,5"/>
     <TextBlock Text="电脑配置指南" Foreground="#9EBBC4" FontSize="12" Margin="8,0,0,35"/>
     <Button x:Name="LiveNav" Content="实时概览" Click="LiveNav_Click" Background="#254854" Foreground="White" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
     <Button x:Name="AdviceNav" Content="配置分析" Click="AdviceNav_Click" Background="Transparent" Foreground="#BCCED4" Margin="0,0,0,8"/>
     <Button x:Name="HistoryNav" Content="历史趋势" Click="HistoryNav_Click" Background="Transparent" Foreground="#BCCED4" Margin="0,0,0,8"/>
     <Button x:Name="SettingsNav" Content="记录设置" Click="SettingsNav_Click" Background="Transparent" Foreground="#BCCED4"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Border Background="#1E3B46" CornerRadius="10" Padding="12" Margin="0,20,0,16"><StackPanel><TextBlock x:Name="RecordState" Text="● 正在准备" Foreground="#70DCC6" FontSize="12"/><TextBlock x:Name="LastTime" Text="等待首次采样" Foreground="#9EBBC4" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
     <Button Content="退出程序" Click="Exit_Click" Background="Transparent" Foreground="#BCCED4"/>
     <TextBlock Text="本地记录 · v0.2" Foreground="#7898A4" FontSize="10" Margin="10,16,0,0"/>
    </StackPanel>
    <Grid/>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,26,30,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="PageTitle" Text="实时概览" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="当前占用、硬件状态与正在运行的应用" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="当前场景" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,10,0"/><ComboBox x:Name="SceneCombo" SelectionChanged="Scene_Changed" Width="138"><ComboBoxItem Content="日常办公"/><ComboBoxItem Content="开发编译"/><ComboBoxItem Content="游戏娱乐"/><ComboBoxItem Content="设计剪辑"/><ComboBoxItem Content="AI 与虚拟机"/></ComboBox><Button x:Name="PauseButton" Content="暂停记录" Click="Pause_Click" Margin="12,0,0,0"/></StackPanel>
   </Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
    <Grid>
     <StackPanel x:Name="LivePage">
      <UniformGrid Columns="4" Margin="-5,0,-5,20">
       <Border Style="{StaticResource Card}" Margin="5,0" Padding="18"><StackPanel><TextBlock Text="CPU" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CpuValue" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,8"/><ProgressBar x:Name="CpuBar" Height="5" Maximum="100" Foreground="#007F73" Background="#E5F1EE" BorderThickness="0"/><TextBlock x:Name="CpuDetail" Text="正在初始化" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="5,0" Padding="18"><StackPanel><TextBlock Text="内存" Foreground="{StaticResource Muted}"/><TextBlock x:Name="MemoryValue" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,8"/><ProgressBar x:Name="MemoryBar" Height="5" Maximum="100" Foreground="#6378C8" Background="#EBEDF8" BorderThickness="0"/><TextBlock x:Name="MemoryDetail" Text="正在初始化" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="5,0" Padding="18"><StackPanel><TextBlock Text="GPU" Foreground="{StaticResource Muted}"/><TextBlock x:Name="GpuValue" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,8"/><ProgressBar x:Name="GpuBar" Height="5" Maximum="100" Foreground="#C38C37" Background="#F7F0E1" BorderThickness="0"/><TextBlock x:Name="GpuDetail" Text="正在初始化" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="5,0" Padding="18"><StackPanel><TextBlock Text="磁盘活动" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DiskValue" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,8"/><ProgressBar x:Name="DiskBar" Height="5" Maximum="100" Foreground="#4B98B7" Background="#E6F0F4" BorderThickness="0"/><TextBlock x:Name="DiskDetail" Text="正在初始化" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
      </UniformGrid>
      <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><DockPanel><TextBlock Text="占用趋势" FontSize="16" FontWeight="SemiBold"/><TextBlock HorizontalAlignment="Right" FontSize="11"><Run Text="● CPU   " Foreground="#007F73"/><Run Text="● 内存   " Foreground="#6378C8"/><Run Text="● GPU" Foreground="#C38C37"/><Run Text="  · 最近 4 分钟" Foreground="#677A87"/></TextBlock></DockPanel><local:TrendChart x:Name="LiveChart" Height="180" Margin="0,20,0,0"/></StackPanel></Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="活跃应用" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/><ItemsControl x:Name="AppList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Grid.Column="1" Text="{Binding Cpu, StringFormat={}{0:0.0}%}" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="{Binding MemoryMb, StringFormat={}{0:0} MB}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
       <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="本机硬件" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock Text="处理器" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="CpuNameLabel" Text="正在识别" Margin="0,5,0,16"/><TextBlock Text="监测显卡" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="GpuNameLabel" Text="正在识别" Margin="0,5,0,16"/><TextBlock x:Name="DriveLabel" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border>
      </Grid>
     </StackPanel>
     <StackPanel x:Name="AdvicePage" Visibility="Collapsed">
      <Border Background="#E5F3EE" CornerRadius="14" Padding="22" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="AnalysisSummary" Text="正在读取使用记录" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="CoverageLabel" Margin="0,10,0,0" Foreground="#456F65"/><TextBlock x:Name="CoverageNext" Text="累计有效使用 10 小时、覆盖 3 天，并确认已记录典型任务。" Margin="0,7,0,0" Foreground="#456F65" FontSize="12"/></StackPanel><Button Grid.Column="1" Content="导出报告" Click="ExportReport_Click" Background="#007F73" Foreground="White" VerticalAlignment="Top" Margin="20,0,0,0"/></Grid></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,20"><Expander x:Name="DemandTrendExpander">
       <Expander.Header><TextBlock x:Name="DemandTrendHeader" Text="近期需求变化 · 对照记录积累中" FontWeight="SemiBold" FontSize="16"/></Expander.Header>
       <StackPanel Margin="0,14,0,0"><TextBlock Text="独立比较最近 7 天与此前 7 天、最近 30 天与此前 30 天。近期反复出现的需求优先影响建议，更早记录用于核对偶发任务。" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
        <ItemsControl x:Name="DemandTrendList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E3EAEC" BorderThickness="0,0,0,1" Padding="0,10,0,14"><StackPanel>
         <DockPanel><TextBlock Text="{Binding Summary}" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusLabel}" HorizontalAlignment="Right" Foreground="#007F73"/></DockPanel>
         <TextBlock Text="{Binding ReadingsLabel}" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
         <TextBlock Text="{Binding BusyLabel}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
         <TextBlock Text="{Binding SceneLabel}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
         <TextBlock Text="{Binding Suggestion}" Margin="0,8,0,0"/>
        </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel>
      </Expander></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel>
       <TextBlock Text="场景明细" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="有效使用时段统计 · P95 按采样时长加权" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,16"/>
       <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="场景" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="有效时长" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="2" Text="CPU P95" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="3" Text="内存峰值" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="4" Text="GPU P95" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="5" Text="GPU 峰值" Foreground="{StaticResource Muted}"/></Grid>
       <ItemsControl x:Name="SceneProfileList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding DurationLabel}"/><TextBlock Grid.Column="2" Text="{Binding CpuP95, StringFormat={}{0:0.0}%, TargetNullValue=—}"/><TextBlock Grid.Column="3" Text="{Binding MemoryPeakGb, StringFormat={}{0:0.0} GB, TargetNullValue=—}"/><TextBlock Grid.Column="4" Text="{Binding GpuP95, StringFormat={}{0:0.0}%, TargetNullValue=—}"/><TextBlock Grid.Column="5" Text="{Binding GpuPeak, StringFormat={}{0:0.0}%, TargetNullValue=—}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <TextBlock x:Name="SceneEmptyLabel" Text="运行常用任务后，这里会显示各场景的实际需求。" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
      </StackPanel></Border>
      <DockPanel Margin="0,0,0,14"><TextBlock Text="逐项配置建议" FontSize="17" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ComboBox x:Name="AnalysisSceneCombo" SelectionChanged="AnalysisScene_Changed" Width="138" Margin="0,0,10,0" AutomationProperties.Name="分析场景"/><ComboBox x:Name="WindowCombo" SelectionChanged="Window_Changed" SelectedIndex="0" AutomationProperties.Name="分析时间范围"><ComboBoxItem Content="最近 7 天" Tag="7"/><ComboBoxItem Content="最近 14 天" Tag="14"/><ComboBoxItem Content="最近 30 天" Tag="30"/><ComboBoxItem Content="最近 90 天" Tag="90"/></ComboBox><Button Content="刷新分析" Click="Refresh_Click" Margin="10,0,0,0"/></StackPanel></DockPanel>
      <ItemsControl x:Name="AdviceList"/>
     </StackPanel>
     <StackPanel x:Name="HistoryPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="历史占用趋势" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="HistorySummary" Foreground="{StaticResource Muted}" Margin="0,8,0,20"/><local:TrendChart x:Name="HistoryChart" Height="250" MaxGapSeconds="5400"/><TextBlock FontSize="12" Margin="0,14,0,0"><Run Text="● CPU   " Foreground="#007F73"/><Run Text="● 内存   " Foreground="#6378C8"/><Run Text="● GPU" Foreground="#C38C37"/><Run Text="  · 每小时平均占用" Foreground="#677A87"/></TextBlock></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,20,0,0"><StackPanel><TextBlock Text="数据与导出" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="记录保存在本机，退出后保留，下次运行继续累计。应用进程列表只实时展示。" Margin="0,10,0,18" Foreground="{StaticResource Muted}"/><WrapPanel><Button Content="导出原始 CSV" Click="ExportCsv_Click" Margin="0,0,12,0"/><Button Content="打开数据文件夹" Click="OpenData_Click"/></WrapPanel></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="使用场景与购机需求" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="RepresentativeCheck" Content="已运行平时的典型任务，当前记录能代表我的使用习惯" Margin="0,22,0,20"/><TextBlock Text="下一台电脑的新需求（选填）" Margin="0,0,0,10"/><TextBox x:Name="FutureBox" Height="84" AcceptsReturn="True" TextWrapping="Wrap" Padding="12" BorderBrush="#D8E2E5" MaxLength="2000"/><TextBlock Text="例如：准备学习视频剪辑、运行本地模型、升级 4K 显示器。新需求会写入报告供选型时核对。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,20"/><Button Content="保存设置" Click="SaveSettings_Click" HorizontalAlignment="Left" Background="#007F73" Foreground="White"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="后台记录" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="CloseToTrayCheck" Content="关闭窗口后继续在系统托盘记录" Margin="0,18,0,14"/><CheckBox x:Name="StartupCheck" Content="登录 Windows 后自动开始记录" Margin="0,0,0,18"/><TextBlock Text="托盘菜单可暂停或退出；休眠与暂停间隔从有效时长中排除。" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="历史保留" VerticalAlignment="Center" Margin="0,0,14,0"/><ComboBox x:Name="RetentionCombo" AutomationProperties.Name="历史保留天数"><ComboBoxItem Content="30 天" Tag="30"/><ComboBoxItem Content="60 天" Tag="60"/><ComboBoxItem Content="90 天" Tag="90"/></ComboBox></StackPanel><TextBlock x:Name="RetentionLabel"/><Button Content="保存后台设置" Click="SaveBackground_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/><TextBlock x:Name="SensorLabel" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="分析方法" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="有效使用包含近期键鼠活动和明显的后台任务。配置判断结合按时长加权的 P95、峰值、持续压力和传感器覆盖率；各项依据可在配置分析中展开。" Margin="0,14,0,14" Foreground="{StaticResource Muted}"/><TextBlock Text="采集：Windows API + LibreHardwareMonitor。规则版本 1.2。" FontSize="12"/><Button Content="打开使用说明" Click="Help_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <TextBlock x:Name="StatusLine" Grid.Row="2" Text="正在初始化采集器…" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0"/>
  </Grid>
 </Grid>
</Window>
