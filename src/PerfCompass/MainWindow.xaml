<Window x:Class="PerfCompass.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PerfCompass"
 Title="PerfCompass · 配置指南" Icon="Assets/App.ico" Width="1240" Height="820" MinWidth="960" MinHeight="640" Background="#F4F7F8" Foreground="{StaticResource Ink}" FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen">
 <Grid Background="#F4F7F8">
  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#132D38" Padding="20,30">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="◈" Foreground="#55D5BC" FontSize="38" Margin="8,0,0,8"/>
     <TextBlock Text="PerfCompass" Foreground="White" FontSize="21" FontWeight="SemiBold" Margin="6,0,0,5"/>
     <TextBlock Text="电脑配置指南" Foreground="#9EBBC4" FontSize="12" Margin="8,0,0,35"/>
     <Button x:Name="LiveNav" Content="实时概览" Click="LiveNav_Click" Background="#254854" Foreground="White" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
     <Button x:Name="AdviceNav" Content="配置分析" Click="AdviceNav_Click" Background="Transparent" Foreground="#BCCED4" Margin="0,0,0,8"/>
     <Button x:Name="ComparisonNav" Content="候选配置" Click="ComparisonNav_Click" Background="Transparent" Foreground="#BCCED4" Margin="0,0,0,8"/>
     <Button x:Name="TaskMeasurementNav" Content="任务测量" Click="TaskMeasurementNav_Click" Background="Transparent" Foreground="#BCCED4" Margin="0,0,0,8"/>
     <Button x:Name="HistoryNav" Content="历史趋势" Click="HistoryNav_Click" Background="Transparent" Foreground="#BCCED4" Margin="0,0,0,8"/>
     <Button x:Name="SettingsNav" Content="记录设置" Click="SettingsNav_Click" Background="Transparent" Foreground="#BCCED4"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Border Background="#1E3B46" CornerRadius="10" Padding="12" Margin="0,20,0,16"><StackPanel><TextBlock x:Name="RecordState" Text="● 正在准备" Foreground="#70DCC6" FontSize="12"/><TextBlock x:Name="LastTime" Text="等待首次采样" Foreground="#9EBBC4" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
     <Button Content="退出程序" Click="Exit_Click" Background="Transparent" Foreground="#BCCED4"/>
     <TextBlock x:Name="ApplicationVersionLabel" Text="本地记录" Foreground="#7898A4" FontSize="10" Margin="10,16,0,0"/>
    </StackPanel>
    <Grid/>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,26,30,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="PageTitle" Text="实时概览" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="当前占用、硬件状态与正在运行的应用" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/><TextBlock x:Name="RecoveryBanner" Foreground="#98631D" Margin="0,7,10,0" Visibility="Collapsed"/><Border x:Name="SettingsErrorPanel" Visibility="Collapsed" Background="#FFF2E3" BorderBrush="#D9A673" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,10,0"><ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="SettingsErrorBanner" Foreground="#8B501D" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></ScrollViewer></Border><Expander x:Name="HistoryQualityNotice" Visibility="Collapsed" Foreground="#98631D" Margin="0,8,10,0"><ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="HistoryQualityDetails" TextWrapping="Wrap" Margin="0,8,0,0"/></ScrollViewer></Expander></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="当前场景" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,10,0"/><ComboBox x:Name="SceneCombo" SelectionChanged="Scene_Changed" Width="138"><ComboBoxItem Content="日常办公"/><ComboBoxItem Content="开发编译"/><ComboBoxItem Content="游戏娱乐"/><ComboBoxItem Content="设计剪辑"/><ComboBoxItem Content="AI 与虚拟机"/></ComboBox><Button x:Name="PauseButton" Content="暂停记录" Click="Pause_Click" Margin="12,0,0,0"/></StackPanel>
   </Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
    <Grid>
     <local:ComparisonView x:Name="ComparisonPage" Visibility="Collapsed"/>
     <local:TaskMeasurementView x:Name="TaskMeasurementPage" Visibility="Collapsed"/>
     <StackPanel x:Name="LivePage">
      <TextBlock x:Name="SensorHealthBanner" Foreground="#98631D" TextWrapping="Wrap" Margin="0,0,0,18" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock x:Name="CpuObservationBanner" Foreground="#98631D" TextWrapping="Wrap" Margin="0,0,0,18" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock x:Name="SamplingTimingBanner" Foreground="#98631D" TextWrapping="Wrap" Margin="0,0,0,18" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock x:Name="LiveDisplayGapBanner" Text="实时曲线出现显示间隔，已保存的采样见历史趋势。" Foreground="#98631D" TextWrapping="Wrap" Margin="0,0,0,18" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
      <Border Style="{StaticResource Card}" Margin="0,0,0,20"><Expander x:Name="ExperienceEntry" Header="刚才卡顿或等待过久？记录体验"><StackPanel Margin="0,14,0,0">
       <TextBlock Text="保存此前两分钟的采样线索，用来核对当时的资源占用。暂停记录时仅保存描述。" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
       <ComboBox x:Name="ExperienceKind" SelectedIndex="0" HorizontalAlignment="Left" MinWidth="150" AutomationProperties.Name="体验类型"><ComboBoxItem Content="操作卡顿"/><ComboBoxItem Content="任务等待过久"/></ComboBox>
       <TextBox x:Name="ExperienceNote" MaxLength="500" Height="54" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,12,0,12" Padding="8" AutomationProperties.Name="正在进行的任务与体验描述" ToolTip="可填写当时的任务、分辨率、等待时间等；请勿填写密码或敏感资料。"/>
       <Button x:Name="RecordExperienceButton" Content="保存体验记录" Click="RecordExperience_Click" HorizontalAlignment="Left" Background="#007F73" Foreground="White"/>
       <TextBlock x:Name="ExperienceStatus" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
      </StackPanel></Expander></Border>
      <UniformGrid Columns="4" Margin="-5,0,-5,20">
       <Border Style="{StaticResource Card}" Margin="5,0" Padding="18"><StackPanel><TextBlock Text="CPU" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CpuValue" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,8"/><ProgressBar x:Name="CpuBar" Height="5" Maximum="100" Foreground="#007F73" Background="#E5F1EE" BorderThickness="0"/><TextBlock x:Name="CpuDetail" Text="正在初始化" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="5,0" Padding="18"><StackPanel><TextBlock Text="内存" Foreground="{StaticResource Muted}"/><TextBlock x:Name="MemoryValue" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,8"/><ProgressBar x:Name="MemoryBar" Height="5" Maximum="100" Foreground="#6378C8" Background="#EBEDF8" BorderThickness="0"/><TextBlock x:Name="MemoryDetail" Text="正在初始化" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="5,0" Padding="18"><StackPanel><TextBlock x:Name="GpuMetricLabel" Text="GPU 核心/3D" Foreground="{StaticResource Muted}"/><TextBlock x:Name="GpuValue" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,8"/><ProgressBar x:Name="GpuBar" Height="5" Maximum="100" Foreground="#C38C37" Background="#F7F0E1" BorderThickness="0"/><TextBlock x:Name="GpuDetail" Text="正在初始化" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="5,0" Padding="18"><StackPanel><TextBlock Text="磁盘活动" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DiskValue" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,8"/><ProgressBar x:Name="DiskBar" Height="5" Maximum="100" Foreground="#4B98B7" Background="#E6F0F4" BorderThickness="0"/><TextBlock x:Name="DiskDetail" Text="正在初始化" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
      </UniformGrid>
      <Border Style="{StaticResource Card}" Margin="0,0,0,20"><Expander x:Name="GpuEngineLiveExpander" Header="GPU 分引擎读数 · 与核心/3D分别观察" IsExpanded="True"><StackPanel Margin="0,12,0,0"><TextBlock x:Name="GpuEngineLiveDetails" Text="等待分引擎读数；缺失不表示零负载。" TextWrapping="Wrap" LineHeight="22"/><TextBlock x:Name="GpuEngineLiveVersion" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Expander></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><DockPanel><TextBlock Text="占用趋势" FontSize="16" FontWeight="SemiBold"/><TextBlock HorizontalAlignment="Right" FontSize="11"><Run Text="● CPU   " Foreground="#007F73"/><Run Text="● 内存   " Foreground="#6378C8"/><Run Text="● GPU 核心/3D" Foreground="#C38C37"/><Run Text="  · 最近 4 分钟" Foreground="#677A87"/></TextBlock></DockPanel><local:TrendChart x:Name="LiveChart" Height="180" Margin="0,20,0,0"/></StackPanel></Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="活跃应用" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/><ItemsControl x:Name="AppList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Grid.Column="1" Text="{Binding Cpu, StringFormat={}{0:0.0}%}" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="{Binding MemoryMb, StringFormat={}{0:0} MiB}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
       <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="本机硬件" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock Text="处理器" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="CpuNameLabel" Text="正在识别" Margin="0,5,0,16"/><TextBlock Text="监测显卡" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="GpuNameLabel" Text="正在识别" Margin="0,5,0,16"/><TextBlock x:Name="DriveLabel" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border>
      </Grid>
     </StackPanel>
     <StackPanel x:Name="AdvicePage" Visibility="Collapsed">
      <DockPanel Margin="0,0,0,14"><TextBlock Text="配置取舍与任务范围" FontSize="17" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ComboBox x:Name="AnalysisSceneCombo" SelectionChanged="AnalysisScene_Changed" Width="138" Margin="0,0,10,0" AutomationProperties.Name="分析场景"/><ComboBox x:Name="WindowCombo" SelectionChanged="Window_Changed" SelectedIndex="0" AutomationProperties.Name="分析时间范围"><ComboBoxItem Content="最近 7 天" Tag="7"/><ComboBoxItem Content="最近 14 天" Tag="14"/><ComboBoxItem Content="最近 30 天" Tag="30"/><ComboBoxItem Content="最近 90 天" Tag="90"/></ComboBox><Button x:Name="RefreshAnalysisButton" Content="刷新分析" Click="Refresh_Click" Margin="10,0,0,0"/></StackPanel></DockPanel>
      <Border Background="#E5F3EE" CornerRadius="14" Padding="22" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="AnalysisSummary" TextWrapping="Wrap" Text="正在读取使用记录" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="CoverageLabel" Margin="0,10,0,0" Foreground="#456F65"/><TextBlock x:Name="CoverageNext" TextWrapping="Wrap" Text="累计有效使用 10 小时、覆盖 3 天，并确认已记录典型任务。" Margin="0,7,0,0" Foreground="#456F65" FontSize="12"/></StackPanel><Button Grid.Column="1" x:Name="ExportAnalysisButton" Content="导出报告" Click="ExportReport_Click" Background="#007F73" Foreground="White" VerticalAlignment="Top" Margin="20,0,0,0"/></Grid></Border>
      <Expander x:Name="ExperienceQualityNotice" Visibility="Collapsed" Header="体验记录读取异常 · 查看位置" Foreground="#98631D" Margin="0,0,0,16"><TextBlock x:Name="ExperienceQualityDetails" TextWrapping="Wrap" Margin="0,8,0,0"/></Expander>
      <Border x:Name="ConfigurationDraftPanel" Style="{StaticResource Card}" Margin="0,0,0,20" Visibility="Collapsed">
       <Border.Resources><DataTemplate x:Key="ConfigurationDraftRows"><Border BorderBrush="#E3EAEC" BorderThickness="0,0,0,1" Padding="0,10"><StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Foreground="#677A87"/><TextBlock Grid.Column="1" Text="{Binding Recommendation}" FontWeight="SemiBold" TextWrapping="Wrap"/></Grid>
        <TextBlock Text="{Binding Spending}" Foreground="#45606C" FontSize="12" TextWrapping="Wrap" Margin="70,6,0,0" LineHeight="19"/>
       </StackPanel></Border></DataTemplate></Border.Resources>
       <StackPanel>
        <TextBlock Text="下一台电脑配置草案" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Scope}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,3" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Baseline.Notice}" Foreground="#98631D" TextWrapping="Wrap"/>
        <ItemsControl x:Name="ConfigurationDraftList" ItemsSource="{Binding Baseline.Rows}" ItemTemplate="{StaticResource ConfigurationDraftRows}"/>
        <Expander x:Name="ConfigurationDraftEvidence" Header="配置依据与适用范围" Margin="0,10,0,0"><ItemsControl ItemsSource="{Binding Baseline.Rows}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,9,0,3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding Scope}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
        <Expander x:Name="ConfigurationDraftConditions" Header="条件成立时的配置" Margin="0,10,0,0"><Expander.Style><Style TargetType="Expander"><Style.Triggers><DataTrigger Binding="{Binding Conditions.Length}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Expander.Style>
         <ItemsControl ItemsSource="{Binding Conditions}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,12,0,4"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Source}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Notice}" Foreground="#98631D" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ConfigurationDraftRows}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </Expander>
        <TextBlock Text="{x:Static local:ConfigurationDraft.Notice}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/>
       </StackPanel>
      </Border>
      <Border x:Name="PurchaseGuidancePanel" Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel>
       <TextBlock Text="当前配置取舍" FontSize="18" FontWeight="SemiBold"/>
       <TextBlock Text="先确定值得比较的方向，再用实际任务筛选候选。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,8"/>
       <ItemsControl x:Name="PurchaseGuidanceList"><ItemsControl.ItemTemplate><DataTemplate>
        <Border Tag="{Binding Key}" BorderBrush="#E3EAEC" BorderThickness="0,0,0,1" Padding="0,12"><StackPanel>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Name}" Foreground="#677A87" TextWrapping="Wrap" Margin="0,0,10,0"/>
          <TextBlock Grid.Column="1" Text="{Binding Direction}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Grid.Column="2" Text="{Binding Level}" Foreground="#007F73" FontSize="11" Margin="16,2,0,0"/>
         </Grid>
         <TextBlock Text="{Binding NextStep}" TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,0" Foreground="#45606C"/>
         <TextBlock Text="{Binding ComparisonAction}" Foreground="#007F73" TextWrapping="Wrap" Margin="0,7,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ComparisonAction}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
         <Expander Header="依据与适用范围" Foreground="#007F73" FontSize="12" Margin="0,7,0,0"><StackPanel Margin="0,7,0,0">
          <TextBlock Text="{Binding Reason}" Foreground="#45606C" TextWrapping="Wrap" LineHeight="21"/>
          <TextBlock Text="{Binding Scope}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
         </StackPanel></Expander>
        </StackPanel></Border>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <Button x:Name="GuidanceCompareButton" Content="比较候选配置" Click="ComparisonNav_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,20"><Expander x:Name="DemandTrendExpander">
       <Expander.Header><TextBlock x:Name="DemandTrendHeader" Text="近期需求变化 · 对照记录积累中" FontWeight="SemiBold" FontSize="16"/></Expander.Header>
       <StackPanel Margin="0,14,0,0"><TextBlock Text="独立比较最近 7 天与此前 7 天、最近 30 天与此前 30 天。近期反复出现的需求优先影响建议，更早记录用于核对偶发任务。" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
        <ItemsControl x:Name="DemandTrendList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E3EAEC" BorderThickness="0,0,0,1" Padding="0,10,0,14"><StackPanel>
         <DockPanel><TextBlock Text="{Binding Summary}" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusLabel}" HorizontalAlignment="Right" Foreground="#007F73"/></DockPanel>
         <TextBlock Text="{Binding ReadingsLabel}" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
         <TextBlock Text="{Binding BusyLabel}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
         <TextBlock Text="{Binding SceneLabel}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
         <TextBlock Text="{Binding Suggestion}" Margin="0,8,0,0"/>
        </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel>
      </Expander></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,20"><Expander x:Name="GpuEngineHistoryExpander" Header="GPU 分引擎历史 · 已暴露节点的观测证据"><StackPanel Margin="0,14,0,0">
       <TextBlock x:Name="GpuEngineHistoryNotice" Text="等待当前硬件与场景的分析。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>
       <ItemsControl x:Name="GpuEngineProfileList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E3EAEC" BorderThickness="0,0,0,1" Padding="0,10,0,12"><StackPanel>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Readings}" Margin="0,7,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Durations}" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Sources}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
       </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></Expander></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel>
       <TextBlock Text="场景明细" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="SceneProfileSummary" Text="有效使用时段统计 · P95 按采样时长加权" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,16"/>
       <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="场景" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="有效时长" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="2" Text="CPU P95" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="3" Text="内存峰值" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="4" Text="GPU 核心/3D P95" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="5" Text="GPU 核心/3D 峰值" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></Grid>
       <ItemsControl x:Name="SceneProfileList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding DurationLabel}"/><TextBlock Grid.Column="2" Text="{Binding CpuP95, StringFormat={}{0:0.0}%, TargetNullValue=—}"/><TextBlock Grid.Column="3" Text="{Binding MemoryPeakGb, StringFormat={}{0:0.0} GiB, TargetNullValue=—}"/><TextBlock Grid.Column="4" Text="{Binding GpuP95, StringFormat={}{0:0.0}%, TargetNullValue=—}"/><TextBlock Grid.Column="5" Text="{Binding GpuPeak, StringFormat={}{0:0.0}%, TargetNullValue=—}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <TextBlock x:Name="SceneEmptyLabel" Text="运行常用任务后，这里会显示各场景的实际需求。" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
      </StackPanel></Border>
      <TextBlock Text="逐项配置依据" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
      <ItemsControl x:Name="AdviceList"/>
     </StackPanel>
     <StackPanel x:Name="HistoryPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="体验记录" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ExperienceSummary" Foreground="{StaticResource Muted}" Margin="0,8,0,12"/><TextBlock Text="与配置分析使用相同的场景和时间范围。处理问题后可标为已处理；记录会保留在报告中。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"/>
       <TextBlock x:Name="ExperienceHistoryQualityNotice" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#98631D" Margin="0,0,0,12"/>
       <ItemsControl x:Name="ExperienceList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E3EAEC" BorderThickness="0,0,0,1" Padding="0,10,0,14"><StackPanel><DockPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding StateLabel}" HorizontalAlignment="Right" Foreground="#007F73"/></DockPanel><TextBlock Text="{Binding Note}" Margin="0,8,0,0"/><TextBlock Text="{Binding ParsedDescription}" Margin="0,8,0,0"/><TextBlock Text="{Binding EvidenceLabel}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/><TextBlock Text="{Binding Conclusion}" Margin="0,8,0,10"/><Button Content="标为已处理" Tag="{Binding}" Click="ResolveExperience_Click" HorizontalAlignment="Left"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Resolved}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="历史占用趋势" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="HistorySummary" Foreground="{StaticResource Muted}" Margin="0,8,0,20"/><TextBlock x:Name="SamplingGapLabel" Foreground="#98631D" Margin="0,0,0,16" Visibility="Collapsed"/><local:TrendChart x:Name="HistoryChart" Height="250" MaxGapSeconds="5400"/><TextBlock FontSize="12" Margin="0,14,0,0"><Run Text="● CPU   " Foreground="#007F73"/><Run Text="● 内存   " Foreground="#6378C8"/><Run Text="● GPU 核心/3D" Foreground="#C38C37"/><Run Text="  · 按读数时长加权的小时均值" Foreground="#677A87"/></TextBlock><TextBlock Text="包含有读数的空闲时段；跨小时记录按区间分摊，未采集的时间不当成零。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,14"/><TextBlock Text="查看时段" Margin="0,0,0,6"/><ComboBox x:Name="HistoryPeriodCombo" DisplayMemberPath="PeriodLabel" SelectionChanged="HistoryPeriod_Changed" HorizontalAlignment="Left" MinWidth="290" AutomationProperties.Name="查看历史小时段"/><TextBlock x:Name="HistoryPeriodDetails" Text="等待有效读数" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="22"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,20,0,0"><StackPanel><TextBlock Text="数据与导出" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="记录保存在本机，退出后保留，下次运行继续累计。应用进程列表只实时展示。" Margin="0,10,0,18" Foreground="{StaticResource Muted}"/><WrapPanel><Button Content="导出原始 CSV" Click="ExportCsv_Click" Margin="0,0,12,0"/><Button Content="打开数据文件夹" Click="OpenData_Click"/></WrapPanel></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="使用场景与购机需求" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="RepresentativeCheck" Content="已在当前硬件配置上运行典型任务，当前记录能代表我的使用习惯" Margin="0,22,0,20"/><TextBlock x:Name="RepresentativeStatus" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,20" TextWrapping="Wrap"/><TextBlock Text="下一台电脑的新需求（选填）" Margin="0,0,0,10"/><TextBox x:Name="FutureBox" TextChanged="FutureBox_Changed" Height="84" AcceptsReturn="True" TextWrapping="Wrap" Padding="12" BorderBrush="#D8E2E5" MaxLength="2000"/><TextBlock Text="例如：准备学习视频剪辑、运行本地模型、升级 4K 显示器。解析并确认后，新需求会参与建议，并连同原文写入报告。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,20"/><StackPanel Margin="0,0,0,16"><Button Content="模型解析与逐项核对" Click="OpenSemantic_Click" HorizontalAlignment="Left" Margin="0,0,0,10"/><Button x:Name="ParseNeedsButton" Content="规则预解析需求" Click="ParseNeeds_Click" HorizontalAlignment="Left"/><ItemsControl x:Name="RequirementsList" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,5,0,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel x:Name="AiModePanel" Visibility="Collapsed" Margin="0,10,0,12"><TextBlock Text="AI 将在哪里运行？本地模型还需核对规模、量化方式与任务目标。" Margin="0,0,0,8"/><ComboBox x:Name="AiModeCombo" SelectedIndex="0" HorizontalAlignment="Left" MinWidth="220" AutomationProperties.Name="AI 使用方式"><ComboBoxItem Content="尚未明确" Tag="unspecified"/><ComboBoxItem Content="在线服务或云端 API" Tag="cloud"/><ComboBoxItem Content="本地运行、训练或微调" Tag="local"/><ComboBoxItem Content="本地与云端都会使用" Tag="both"/></ComboBox></StackPanel><CheckBox x:Name="RequirementsConfirm" Content="已核对上述解析结果，将其用于配置建议" Margin="0,12,0,10"/><TextBlock x:Name="RequirementsStatus" Text="支持常见任务、否定词、未来意图与部分显示目标；未知描述保留待补充。" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel><Button x:Name="SaveRequirementsButton" Content="保存设置" Click="SaveSettings_Click" HorizontalAlignment="Left" Background="#007F73" Foreground="White"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20"><Expander x:Name="SemanticPanel" Header="逐项核对需求（可选模型提取）"><StackPanel Margin="0,14,0,0">
       <TextBlock Text="模型可识别开放任务及购机条件，但结果可能遗漏或误解。只发送上方的需求描述；不会发送采样、进程或硬件信息。请使用支持 JSON Schema 的聊天接口。" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
       <Expander x:Name="ModelConnectionExpander" Header="模型连接（未配置）" IsExpanded="True" Margin="0,0,0,12"><StackPanel Margin="0,10,0,0"><TextBlock Text="模型聊天接口地址"/><TextBox x:Name="ModelEndpointBox" Margin="0,6,0,12" Padding="8" MaxLength="500" AutomationProperties.Name="模型聊天接口地址"/>
       <TextBlock Text="模型名称"/><TextBox x:Name="ModelNameBox" Margin="0,6,0,12" Padding="8" MaxLength="150" AutomationProperties.Name="模型名称"/>
       <TextBlock Text="API 密钥（仅在本次运行保留，不写入磁盘）"/><PasswordBox x:Name="ModelApiKey" Margin="0,6,0,12" Padding="8" MaxLength="500" AutomationProperties.Name="模型 API 密钥"/>
       </StackPanel></Expander><TextBlock Text="本机模型会改变被测占用。调用本机地址时将暂停监测，停止模型服务后再继续记录。更改接口地址即更改文本接收方，请核对提供方的数据处理规则。" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
       <WrapPanel><Button x:Name="ExtractSemanticButton" Content="发送描述并解析" Click="ExtractSemantic_Click" Background="#007F73" Foreground="White" Margin="0,0,10,10"/><Button x:Name="CancelSemanticButton" Content="取消解析" Click="CancelSemantic_Click" IsEnabled="False" Margin="0,0,10,10"/><Button Content="手工补充事项" Click="AddSemantic_Click" Margin="0,0,0,10"/></WrapPanel>
       <TextBlock x:Name="SemanticStatus" Text="尚未配置模型服务，软件不会自动发送描述。" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
       <Expander x:Name="SemanticQuestionExpander" Visibility="Collapsed" Header="模型提出的待澄清问题" Margin="0,0,0,12"><TextBlock x:Name="SemanticQuestions" Margin="0,10,0,0"/></Expander><TextBlock Text="完整需求原文" Margin="0,0,0,5"/><TextBox x:Name="SemanticSourcePreview" IsReadOnly="True" MaxHeight="110" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" Margin="0,0,0,14" AutomationProperties.Name="待核对需求原文"/>
       <ItemsControl x:Name="SemanticEditors"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F4F7F8" CornerRadius="8" Padding="14" Margin="0,0,0,12"><StackPanel>
        <CheckBox Content="核对后纳入建议" IsChecked="{Binding Include, Mode=TwoWay}" Margin="0,0,0,12"/>
        <TextBlock Text="事项或软件（可修改）"/><TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" Padding="6" Margin="0,5,0,10" AutomationProperties.Name="候选事项名称"/>
        <WrapPanel><ComboBox ItemsSource="{Binding Kinds}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Kind, Mode=TwoWay}" MinWidth="120" Margin="0,0,10,10" AutomationProperties.Name="事项类型"/><ComboBox ItemsSource="{Binding Polarities}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Polarity, Mode=TwoWay}" MinWidth="150" Margin="0,0,10,10" AutomationProperties.Name="肯定否定与条件"/><ComboBox ItemsSource="{Binding Timeframes}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Timeframe, Mode=TwoWay}" MinWidth="110" Margin="0,0,0,10" AutomationProperties.Name="原文时间"/></WrapPanel>
        <TextBlock Text="内容或数值"/><TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Padding="6" Margin="0,5,0,10"/>
        <TextBlock Text="单位（无则留空）"/><TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Padding="6" Margin="0,5,0,10"/>
        <TextBlock Text="触发条件（条件事项必填）"/><TextBox Text="{Binding Condition, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Padding="6" Margin="0,5,0,10"/>
        <TextBlock Text="逐字原文依据（可扩展以包含否定、时间或条件）"/><TextBox Text="{Binding Evidence, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" Padding="6" TextWrapping="Wrap" Margin="0,5,0,0"/>
        <TextBlock Text="这项内容怎样影响选机"/><ComboBox ItemsSource="{Binding DecisionUses}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding DecisionUse, Mode=TwoWay}" MinWidth="210" HorizontalAlignment="Left" Margin="0,5,0,10" AutomationProperties.Name="购机用途"/>
        <TextBlock Text="{Binding QuantityPreview}" Foreground="{StaticResource Accent}" Margin="0,12,0,0"/>
       </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <CheckBox x:Name="SemanticReviewConfirm" Content="已核对完整原文，包括模型可能遗漏的内容" Margin="0,8,0,14"/>
       <Button x:Name="SaveSemanticButton" Content="保存选用事项并用于建议" Click="SaveSemantic_Click" HorizontalAlignment="Left" Background="#007F73" Foreground="White"/>
      </StackPanel></Expander></Border><Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="后台记录" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="CloseToTrayCheck" Content="关闭窗口后继续在系统托盘记录" Margin="0,18,0,14"/><CheckBox x:Name="StartupCheck" Content="登录 Windows 后自动开始记录" Margin="0,0,0,18"/><TextBlock Text="托盘菜单可暂停或退出；休眠与暂停间隔从有效时长中排除。" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="历史保留" VerticalAlignment="Center" Margin="0,0,14,0"/><ComboBox x:Name="RetentionCombo" AutomationProperties.Name="历史保留天数"><ComboBoxItem Content="30 天" Tag="30"/><ComboBoxItem Content="60 天" Tag="60"/><ComboBoxItem Content="90 天" Tag="90"/></ComboBox></StackPanel><TextBlock x:Name="RetentionLabel"/><TextBlock x:Name="BackgroundSaveStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/><Button x:Name="SaveBackgroundButton" Content="保存后台设置" Click="SaveBackground_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/><TextBlock x:Name="SensorLabel" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="数据保护" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="DataProtectionLabel" Text="备份历史、需求和候选比较，恢复到新目录。" Margin="0,12,0,12"/><Button x:Name="DataProtectionButton" Content="备份与恢复…" Click="DataProtection_Click" HorizontalAlignment="Left"/><Button x:Name="ConfirmRecoveredSettingsButton" Content="已核对当前设置，保存恢复结果" Click="ConfirmRecoveredSettings_Click" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="分析方法" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="有效使用包含近期键鼠活动和明显的后台任务。配置判断结合按时长加权的 P95、峰值、持续压力和传感器覆盖率；各项依据可在配置分析中展开。" Margin="0,14,0,14" Foreground="{StaticResource Muted}"/><TextBlock Text="采集：Windows API + LibreHardwareMonitor。规则版本 1.10。" FontSize="12"/><Button Content="打开使用说明" Click="Help_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <TextBlock x:Name="StatusLine" Grid.Row="2" Text="正在初始化采集器…" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0"/>
  </Grid>
 </Grid>
</Window>
