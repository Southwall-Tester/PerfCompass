<Window x:Class="PerfCompass.DataProtectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="备份与恢复 · PerfCompass" Width="760" Height="760" MinWidth="650" MinHeight="570" WindowStartupLocation="CenterOwner" Background="#F4F7F8" Foreground="{StaticResource Ink}" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Border Background="#F4F7F8"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="备份与恢复" FontSize="25" FontWeight="SemiBold"/>
   <TextBlock Text="此窗口打开期间暂停监测，关闭后恢复此前状态。备份未加密，包含历史、需求原文、候选配置及测量参数，请保存在可信位置。" Foreground="{StaticResource Muted}" Margin="0,12,0,20"/>
   <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
    <TextBlock Text="备份数据目录" FontSize="17" FontWeight="SemiBold"/>
    <TextBlock Text="包含数据目录中已保存的设置、历史、体验、候选比较、测量结果及损坏设置原件。创建前先保存当前候选草稿；未保存的测量需先导出。另存到其他目录的文件请单独保管。排除日志、程序和模型文件。" Margin="0,10,0,14"/>
    <Button x:Name="CreateBackupButton" Content="保存备份…" Click="Create_Click" HorizontalAlignment="Left"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
    <TextBlock Text="恢复到新目录" FontSize="17" FontWeight="SemiBold"/>
    <TextBlock Text="先校验备份，再选择父目录。软件会创建新的恢复文件夹；当前数据继续保留。恢复目录首次打开时暂停监测与历史自动清理。" Margin="0,10,0,14"/>
    <Button x:Name="SelectBackupButton" Content="选择并校验备份…" Click="Select_Click" HorizontalAlignment="Left"/>
    <TextBlock x:Name="BackupPathLabel" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
    <TextBlock x:Name="BackupPreviewLabel" Margin="0,10,0,14"/>
    <Button x:Name="RestoreBackupButton" Content="选择目录并恢复…" Click="Restore_Click" HorizontalAlignment="Left" IsEnabled="False"/>
    <TextBlock x:Name="RestoredPathLabel" Margin="0,12,0,8"/>
    <Button x:Name="OpenRestoredButton" Content="用恢复数据打开新窗口（暂停记录）" Click="OpenRestored_Click" HorizontalAlignment="Left" Visibility="Collapsed"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="自动清理保护" FontSize="17" FontWeight="SemiBold"/>
    <TextBlock x:Name="ProtectionLabel" Margin="0,10,0,14"/>
    <Button x:Name="EnableRetentionButton" Content="核对并重新启用自动清理…" Click="EnableRetention_Click" HorizontalAlignment="Left"/>
   </StackPanel></Border>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="1" Margin="0,18,0,0"><ProgressBar x:Name="WorkProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed"/>
   <TextBlock x:Name="OperationStatus" Text="请选择操作。" Margin="0,10,0,10"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelWorkButton" Content="取消操作" Click="Cancel_Click" IsEnabled="False" Margin="0,0,10,0"/><Button x:Name="CloseButton" Content="关闭" Click="Close_Click"/></StackPanel>
  </StackPanel>
 </Grid></Border>
</Window>
